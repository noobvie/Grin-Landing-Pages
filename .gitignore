# ── OS junk ───────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# ── Editor/IDE ────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Secrets / env ─────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key

# ── Server-local deploy state (per-machine, never commit) ─────────────────────
deploy/deploy_state.conf

# ── Generated GA4 tag (injected into the deployed copy at deploy time) ────────
# Kept out of git so the source tree stays raw and pulls never collide on it.
web/*/js/ga4.js
