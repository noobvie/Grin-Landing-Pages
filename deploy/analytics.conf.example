# ─────────────────────────────────────────────────────────────────────────────
# analytics.conf — GA4 Measurement ID map for site_manager.sh
#
# Usage:
#   cp deploy/analytics.conf.example deploy/analytics.conf
#   # Edit this file, then run:
#   ./site_manager.sh --action analytics_ga4              # batch: all sites
#   ./site_manager.sh --action analytics_ga4 --site NAME  # single site
#
# Format:  SITE_DIR_NAME="G-XXXXXXXXXX"
# Each key must match a subdirectory under web/ (e.g. "grin-money-2026").
# Lines starting with # are comments. Blank lines are ignored.
# ─────────────────────────────────────────────────────────────────────────────

grin-money-2026="G-98GRB5MKDT"
grinnode-org-2026="G-EERXEJ55PZ"
